# --- Binaries & Executables ---
# Compiled binaries (usually named after the project folder)
./api
/bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
# If you build your main app to a specific file name, add it here
/main
/server

# --- Test Artifacts ---
# Test binary, built with `go test -c`
*.test
# Output of the go coverage tool
*.out
*.coverprofile
coverage.txt

# --- Dependency Management ---
# Most Go projects do NOT ignore vendor/ unless you specifically want 
# to keep dependencies in your repo. Usually, go.mod/go.sum are enough.
# vendor/

# --- Environment & Secrets ---
# NEVER commit your secrets
.env
.env.local
*.secret
*.key
*.pem

# --- IDE & Editor Specific ---
# JetBrains (GoLand, IntelliJ)
.idea/
*.iws
*.iml
*.ipr

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Vim/Emacs
*~
*.swp
*.swo

# --- System Files ---
.DS_Store
Thumbs.db

# Delve
__debug_bin*